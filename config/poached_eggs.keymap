#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    macros {
        // "00"（KP_N0 を 2 回送る）numpad 用マクロ

        num_00: num_00 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_N0 &kp KP_N0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        lang1 {
            bindings = <&kp LANG1>;
            key-positions = <19 20>;
        };

        lang2 {
            bindings = <&kp LANG2>;
            key-positions = <16 15>;
        };

        bt {
            bindings = <&mo 4>;
            key-positions = <34 33>;
        };

        unlock {
            bindings = <&studio_unlock>;
            key-positions = <0 1 11 10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp Q         &kp W         &kp E      &kp R                   &kp T                                           &kp Y        &kp U  &kp I      &kp O    &kp P     &kp BACKSPACE
&kp TAB    &kp A         &kp S         &kp D      &kp F                   &kp G                                           &kp H        &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT  &kp Z         &kp X         &kp C      &kp V                   &kp B                                           &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LEFT_GUI  &kp LEFT_ALT  &kp SPACE  &mt LEFT_ALT BACKSPACE  &lt 2 LANG2  &mt LSHIFT ENTER  &mt LCTRL SPACE  &lt 1 LANG1  &none  &none      &none    &none     &kp RCTRL
            >;
        };

        layer_1 {
            display-name = "Num";
            bindings = <
&trans  &kp N1        &kp N2  &kp N3  &kp N4     &kp N5                         &kp N6                &kp N7     &kp N8     &kp N9    &kp N0    &trans
&trans  &kp LEFT_GUI  &none   &none   &none      &kp LS(LC(N))                  &kp GRAVE             &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &trans
&trans  &none         &none   &none   &kp LG(V)  &kp LS(LG(S))                  &kp NON_US_BACKSLASH  &kp BSLH   &none      &none     &none     &kp ENTER
&trans  &trans        &trans  &trans  &kp DEL    &trans         &trans  &trans  &trans                &trans     &trans     &trans    &trans    &trans
            >;
        };

        layer_2 {
            display-name = "Mark";
            bindings = <
&trans  &kp EXCL      &kp AT  &kp HASH       &kp DLLR       &kp PRCNT                  &kp CARET  &kp AMPS             &kp STAR  &kp LPAR  &kp RPAR  &trans
&trans  &kp LEFT_GUI  &none   &none          &none          &none                      &kp TILDE  &kp UNDER            &kp PLUS  &kp LBRC  &kp RBRC  &kp DQT
&trans  &none         &none   &kp LS(LC(C))  &kp LS(LC(V))  &none                      &none      &kp LS(NON_US_BSLH)  &kp PIPE  &none     &none     &kp ENTER
&trans  &trans        &trans  &trans         &trans         &trans     &trans  &trans  &trans     &trans               &trans    &trans    &trans    &trans
            >;
        };

        layer_3 {
            display-name = "Function";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3                  &kp F4       &kp F5                                   &kp F6          &kp F7           &kp F8        &kp F9           &kp F10  &trans
&trans  &kp F11  &kp F12  &kp LG(LC(LEFT_ARROW))  &kp LG(TAB)  &kp LC(LG(RIGHT_ARROW))                  &kp LEFT_ARROW  &kp DOWN_ARROW   &kp UP_ARROW  &kp RIGHT_ARROW  &none    &trans
&trans  &none    &none    &none                   &none        &none                                    &kp LA(TAB)     &kp LS(LA(TAB))  &none         &none            &none    &trans
&trans  &trans   &trans   &trans                  &trans       &trans                   &trans  &trans  &trans          &trans           &trans        &trans           &trans   &trans
            >;
        };

        layer_4 {
            display-name = "BT";
            bindings = <
&trans  &trans        &trans          &trans        &trans        &trans                        &none   &none   &none   &none   &none         &trans
&trans  &trans        &trans          &trans        &trans        &trans                        &none   &none   &none   &none   &none         &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                  &none   &none   &none   &none   &out OUT_TOG  &trans
&trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        layer_3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
